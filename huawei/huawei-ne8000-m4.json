{
  "tipo": "Router",
  "fabricante": "Huawei",
  "modelo": "NE8000 M4",
  "snmp_version": "2c",
  "descricao": "Roteador Huawei NE8000 M4 (VRP) — interfaces, CPU/memória/temperatura por placa, uptime e óptica SFP/DDM. Mesma HUAWEI-ENTITY-EXTENT-MIB validada no NE40.",
  "nota_geral": "Óptica (hwOpticalModuleInfoTable) e recursos por placa (hwEntityStateTable) são indexados por entPhysicalIndex (NÃO ifIndex); discovery_oid dessas capabilities é o entPhysicalName (1.3.6.1.2.1.47.1.1.1.1.7). Requer discovery genérico no poller (Option B). Estrutura/escala validadas num NE40E real; mesma MIB esperada no NE8000 M4 — confirme no equipamento. Óptica em dBm divisor 100 (-5000 = -50 dBm = porta sem luz). Triggers com auto_create:false.",
  "capabilities": [
    {
      "id": "interfaces",
      "label": "Interfaces de Rede",
      "requer_discovery": true,
      "discovery_oid": "1.3.6.1.2.1.31.1.1.1.1",
      "itens": [
        {
          "id": "if_oper_status", "nome": "Status Operacional", "tipo": "SNMP_INT",
          "oid_template": "1.3.6.1.2.1.2.2.1.8.{index}",
          "value_map": { "1": "Up", "2": "Down", "3": "Testing", "4": "Unknown", "5": "Dormant", "6": "Not Present", "7": "Lower Layer Down" },
          "triggers": [ { "id": "interface_down", "nome": "Interface caiu", "condicao": "=", "threshold": 2, "severidade": "warning", "auto_create": false, "mensagem": "Interface {interface} em {host} está DOWN" } ]
        },
        { "id": "if_in_octets", "nome": "Tráfego Entrada", "tipo": "DELTA_BYTES", "oid_template": "1.3.6.1.2.1.31.1.1.1.6.{index}", "oid_template_32bit": "1.3.6.1.2.1.2.2.1.10.{index}", "unidade": "bps" },
        { "id": "if_out_octets", "nome": "Tráfego Saída", "tipo": "DELTA_BYTES", "oid_template": "1.3.6.1.2.1.31.1.1.1.10.{index}", "oid_template_32bit": "1.3.6.1.2.1.2.2.1.16.{index}", "unidade": "bps" },
        { "id": "if_in_errors", "nome": "Erros Entrada", "tipo": "DELTA_BYTES", "oid_template": "1.3.6.1.2.1.2.2.1.14.{index}", "unidade": "erros/s" },
        { "id": "if_out_errors", "nome": "Erros Saída", "tipo": "DELTA_BYTES", "oid_template": "1.3.6.1.2.1.2.2.1.20.{index}", "unidade": "erros/s" }
      ]
    },
    {
      "id": "board_resources",
      "label": "CPU, Memória e Temperatura por placa",
      "requer_discovery": true,
      "discovery_oid": "1.3.6.1.2.1.47.1.1.1.1.7",
      "nota": "hwEntityStateTable, indexada por entPhysicalIndex. Selecione a placa de controle (MPU/IPU). Entidades sem CPU/sensor retornam 0.",
      "itens": [
        {
          "id": "cpu_usage", "nome": "CPU", "tipo": "SNMP_INT",
          "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5.{index}", "unidade": "%",
          "triggers": [ { "id": "cpu_alta", "nome": "CPU alta", "condicao": ">=", "threshold": 80, "severidade": "warning", "auto_create": false, "mensagem": "Placa {interface} em {host}: CPU em {valor}%" } ]
        },
        {
          "id": "memory_percent", "nome": "Memória Usada", "tipo": "SNMP_INT",
          "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7.{index}", "unidade": "%",
          "triggers": [ { "id": "memoria_alta", "nome": "Memória alta", "condicao": ">=", "threshold": 85, "severidade": "warning", "auto_create": false, "mensagem": "Placa {interface} em {host}: memória em {valor}%" } ]
        },
        {
          "id": "temperature", "nome": "Temperatura", "tipo": "SNMP_INT",
          "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11.{index}", "unidade": "°C",
          "triggers": [ { "id": "temperatura_alta", "nome": "Temperatura alta", "condicao": ">=", "threshold": 65, "severidade": "warning", "auto_create": false, "mensagem": "Placa {interface} em {host}: {valor}°C" } ]
        }
      ]
    },
    {
      "id": "system",
      "label": "Uptime",
      "requer_discovery": false,
      "itens": [ { "id": "uptime", "nome": "Uptime", "tipo": "SNMP_TIMETICKS", "oid": "1.3.6.1.2.1.1.3.0", "unidade": "s" } ]
    },
    {
      "id": "sfp_ddm",
      "label": "Óptica SFP / DDM",
      "requer_discovery": true,
      "discovery_oid": "1.3.6.1.2.1.47.1.1.1.1.7",
      "nota": "hwOpticalModuleInfoTable, indexada por entPhysicalIndex. Potências dBm divisor 100. Portas sem SFP retornam -5000 ou 0 — pular no poller.",
      "itens": [
        { "id": "sfp_serial", "nome": "Serial da SFP", "tipo": "SNMP_STRING", "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.4.{index}" },
        {
          "id": "sfp_rx_power", "nome": "RX Power", "tipo": "SNMP_FLOAT",
          "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.8.{index}", "divisor": 100, "unidade": "dBm",
          "triggers": [
            { "id": "rx_power_baixo", "nome": "RX óptico baixo", "condicao": "<=", "threshold": -2500, "severidade": "warning", "auto_create": false, "mensagem": "Interface {interface} em {host}: RX óptico baixo ({valor})" },
            { "id": "rx_power_critico", "nome": "RX óptico crítico", "condicao": "<=", "threshold": -3000, "severidade": "critical", "auto_create": false, "mensagem": "Interface {interface} em {host}: RX óptico crítico ({valor})" }
          ]
        },
        { "id": "sfp_tx_power", "nome": "TX Power", "tipo": "SNMP_FLOAT", "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.9.{index}", "divisor": 100, "unidade": "dBm" },
        { "id": "sfp_temperature", "nome": "Temperatura SFP", "tipo": "SNMP_INT", "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.5.{index}", "unidade": "°C" },
        { "id": "sfp_type", "nome": "Tipo da SFP", "tipo": "SNMP_STRING", "oid_template": "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.10.{index}" }
      ]
    }
  ]
}
