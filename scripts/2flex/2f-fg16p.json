{
  "tipo":        "OLT",
  "fabricante":  "2Flex",
  "modelo":      "2F-FG16P",
  "descricao":   "Script de provisionamento + correlação de ONUs via Telnet — 2Flex 2F-FG16P (16 PONs).",
  "protocol":    "telnet",

  "auth": {
    "login_prompt":    "Login:",
    "password_prompt": "Password:",
    "ready_prompt":    "[#>]\\s*$",
    "init_commands":   ["enable", "configure terminal"]
  },

  "actions": {

    "scan_profiles": {
      "descricao": "Parseia auto-auth bindings do running-config para descobrir line/srv profile de cada PON.",
      "commands":     ["show running-config"],
      "read_timeout": 30
    },

    "scan_unprovisioned": {
      "descricao": "Lista ONUs em autofind. Roda dentro do contexto interface gpon 0/{pon}.",
      "commands": ["show onu gpon autofind"],
      "loop": {
        "type":            "per_pon",
        "context_command": "interface gpon 0/{pon}",
        "exit_command":    "exit",
        "port_count":      16
      },
      "row_pattern": "S/P\\s*:\\s*([\\d/]+)[\\s\\S]*?Onu\\s+SN\\s*:\\s*([0-9A-Za-z]+)[\\s\\S]*?Onu\\s+autofind\\s+time\\s*:\\s*([\\d/]+\\s+[\\d:]+)",
      "row_fields": {
        "pon":       {"group": 1, "tipo": "STRING"},
        "serial":    {"group": 2, "tipo": "STRING"},
        "found_at":  {"group": 3, "tipo": "STRING"}
      },
      "read_timeout": 20
    },

    "list_used_slots": {
      "descricao": "Lista slots ocupados em UMA PON especifica.",
      "commands": [
        "interface gpon 0/{pon}",
        "show onuinfo gpon all"
      ],
      "row_pattern": "^\\s*\\d+/\\d+/(\\d+)\\s+\\S+",
      "row_fields": {
        "slot": {"group": 1, "tipo": "INT"}
      },
      "read_timeout": 12
    },

    "provision": {
      "descricao": "Provisiona uma ONU. Inputs auto_from: pon_profile vem do banco do NocFlex.",
      "inputs": [
        {"key": "pon",          "label": "Porta PON",       "type": "number", "required": true},
        {"key": "slot",         "label": "Slot ONU",        "type": "number", "required": true, "auto_from": "next_free_slot"},
        {"key": "serial",       "label": "Serial",          "type": "string", "required": true},
        {"key": "line_profile", "label": "Line profile",    "type": "number", "required": true, "auto_from": "pon_profile"},
        {"key": "srv_profile",  "label": "Service profile", "type": "number", "required": true, "auto_from": "pon_profile"}
      ],
      "commands": [
        "interface gpon 0/{pon}",
        "onu add {slot} sn-auth {serial} omci onu-lineprofile-id {line_profile} onu-srvprofile-id {srv_profile}"
      ],
      "success_pattern": "^(?!.*[Ee]rror)(?!.*[Ff]ailed)(?!.*[Ii]nvalid).*$",
      "read_timeout": 15
    },

    "unprovision": {
      "descricao": "Remove uma ONU ja cadastrada. Apos o delete, se ela ainda estiver conectada, volta pro autofind.",
      "inputs": [
        {"key": "pon",  "label": "Porta PON", "type": "number", "required": true},
        {"key": "slot", "label": "Slot ONU",  "type": "number", "required": true}
      ],
      "commands": [
        "interface gpon 0/{pon}",
        "onu delete {slot}"
      ],
      "success_pattern": "^(?!.*[Ee]rror)(?!.*[Ff]ailed)(?!.*[Ii]nvalid).*$",
      "read_timeout": 10
    },

    "mac_table": {
      "descricao": "Lista MACs aprendidos atras de cada ONU (CPE do cliente). Roda no contexto da PON. Usado pela correlacao automatica ONU->MAC->login PPPoE->cliente.",
      "commands": ["show mac-addr pon vlan all"],
      "loop": {
        "type":            "per_pon",
        "context_command": "interface gpon 0/{pon}",
        "exit_command":    "exit",
        "port_count":      16
      },
      "row_pattern": "^\\s*\\d+\\s+([0-9a-fA-F]{4}\\.[0-9a-fA-F]{4}\\.[0-9a-fA-F]{4})\\s+(\\d+)/\\S+\\s+(\\w+)\\s+ONU\\s+(\\d+)/(\\d+)\\s*:(\\d+)\\s+(\\d+)",
      "row_fields": {
        "mac_dotted": {"group": 1, "tipo": "STRING"},
        "vlan":       {"group": 2, "tipo": "INT"},
        "state":      {"group": 3, "tipo": "STRING"},
        "slot":       {"group": 4, "tipo": "INT"},
        "pon":        {"group": 5, "tipo": "INT"},
        "onu":        {"group": 6, "tipo": "INT"},
        "gem":        {"group": 7, "tipo": "INT"}
      },
      "read_timeout": 15
    }

  }
}
