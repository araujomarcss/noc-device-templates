  "onu_table": {
    "descricao": "Tabela de ONUs — GPON-ONU-IF-MIB (onuIfTable). Base enterprise 3709. Caminho melhor que o template Zabbix antigo.",
    "base_oid": "1.3.6.1.4.1.3709.3.6.2.1.1",
    "snmp_options": "",
    "nota": "GPON-ONU-IF-MIB onuIfTable. Sub-OIDs confirmados pela MIB Reference: .2=descr, .4=name, .6=operStatus, .20=TX, .21=RX, .22=alias, .25=uptime. O index de cada ONU segue o ifIndex do DmOS. Para serial/firmware da ONU, pode ser necessário cruzar com outra tabela GPON (a onuIfTable não tem serial diretamente — confirmar se .2/descr ou .4/name trazem o SN).",
    "fields": {
      "descr": {
        "sub_oid": ".2",
        "tipo": "STRING",
        "label": "Descrição",
        "nota": "onuifDescr — geralmente formato gpon-1/1/X-onu-N"
      },
      "name": {
        "sub_oid": ".4",
        "tipo": "STRING",
        "label": "Nome/Serial",
        "nota": "onuifName — pode conter o serial ou nome configurado"
      },
      "oper_status": {
        "sub_oid": ".6",
        "tipo": "INT",
        "label": "Status",
        "nota": "onuifOperStatus — 1=up/online, 2=down/offline (confirmar)"
      },
      "rx_power": {
        "sub_oid": ".21",
        "tipo": "INT",
        "label": "RX",
        "unidade": "dBm",
        "conversao": "dividir",
        "divisor": 10,
        "nota": "onuIfOnuPowerRx. Divisor a calibrar (provavelmente ÷10). Valor confirmado funcionando no print como -18/-20/-22."
      },
      "tx_power": {
        "sub_oid": ".20",
        "tipo": "INT",
        "label": "TX",
        "unidade": "dBm",
        "conversao": "dividir",
        "divisor": 10,
        "nota": "onuIfOnuPowerTx. Divisor a calibrar."
      },
      "alias": {
        "sub_oid": ".22",
        "tipo": "STRING",
        "label": "Alias",
        "nota": "onuIfAlias — nome amigável configurado"
      },
      "uptime": {
        "sub_oid": ".25",
        "tipo": "TIMETICKS",
        "label": "Uptime ONU",
        "nota": "onuSysUpTime — tempo online da ONU. Útil pra detectar reinícios."
      }
    },
    "status_field": "oper_status",
    "status_values": {
      "online": [1],
      "offline": [2, 0]
    },
    "location_field": "descr",
    "location_parser": "datacom_gpon_path",
    "nota_location": "A localização vem do onuifDescr no formato gpon-1/1/X-onu-N. Parser deve extrair PON (X) e ONU (N)."
  },

  "onu_optical_power_snmp": {
    "descricao": "Potência óptica das ONUs — GPON-ONU-IF-MIB. RX confirmado no print.",
    "base_oid": "1.3.6.1.4.1.3709.3.6.2.1.1",
    "snmp_options": "",
    "fields": {
      "rx_power": {"sub_oid": ".21", "tipo": "INT", "label": "RX", "unidade": "dBm", "conversao": "dividir", "divisor": 10, "nota": "onuIfOnuPowerRx — confirmado funcionando"},
      "tx_power": {"sub_oid": ".20", "tipo": "INT", "label": "TX", "unidade": "dBm", "conversao": "dividir", "divisor": 10, "nota": "onuIfOnuPowerTx"}
    },
    "nota": "Divisor ÷10 é estimativa. Calibrar comparando valor SNMP cru vs leitura do CLI 'show interface gpon 1/1/X onu N rssi'."
  },

