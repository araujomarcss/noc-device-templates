      "gPonOnuBatteryLowAlarm": {"oid": "1.3.6.1.4.1.3709.2.4 (.23)", "classificacao": "FALTA_ENERGIA_CLIENTE", "nota": "Bateria da ONU baixa"},
      "gPonOnuDiscoveredEvent": {"oid": "1.3.6.1.4.1.3709.2.4 (.27)", "classificacao": "ONU_DESCOBERTA", "nota": "ONU voltou/descoberta — útil pra marcar retorno"}
